@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@MICROLLM_HAS_HIP@)
    find_dependency(HIP CONFIG)
endif()
if(@MICROLLM_HAS_HIPBLASLT@)
    find_dependency(hipblaslt CONFIG)
endif()
if(@MICROLLM_HAS_RCCL@)
    find_dependency(rccl CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/microLLMTargets.cmake")

set(microLLM_VERSION "@PROJECT_VERSION@")
set(microLLM_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(microLLM_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(microLLM_VERSION_PATCH "@PROJECT_VERSION_PATCH@")
set(microLLM_CXX_STANDARD 20)
set(microLLM_HIP_ARCHITECTURES "@CMAKE_HIP_ARCHITECTURES@")
set(microLLM_WITH_HIP @MICROLLM_HAS_HIP@)
set(microLLM_WITH_HIPBLASLT @MICROLLM_HAS_HIPBLASLT@)
set(microLLM_WITH_RCCL @MICROLLM_HAS_RCCL@)
set(microLLM_WITH_ROCWMMA @MICROLLM_HAS_ROCWMMA@)
set(microLLM_WITH_CAPI @MICROLLM_BUILD_CAPI@)
set(microLLM_WITH_SANITIZERS @MICROLLM_ENABLE_SANITIZERS@)
set(microLLM_WITH_COVERAGE @MICROLLM_ENABLE_COVERAGE@)
set(microLLM_AVAILABLE_COMPONENTS "@MICROLLM_PACKAGE_COMPONENTS@")
foreach(_microLLM_component IN LISTS microLLM_FIND_COMPONENTS)
    if(_microLLM_component IN_LIST microLLM_AVAILABLE_COMPONENTS AND
       TARGET microLLM::${_microLLM_component})
        set(microLLM_${_microLLM_component}_FOUND TRUE)
    else()
        set(microLLM_${_microLLM_component}_FOUND FALSE)
        if(microLLM_FIND_REQUIRED_${_microLLM_component})
            string(CONCAT microLLM_NOT_FOUND_MESSAGE
                "Requested component '${_microLLM_component}' is unavailable. "
                "Available components: ${microLLM_AVAILABLE_COMPONENTS}")
        endif()
    endif()
endforeach()
check_required_components(microLLM)
